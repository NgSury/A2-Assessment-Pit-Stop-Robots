#helper functions

import numpy as np
from spatialmath import SE3

def back(distance):
    """Return a transformation that moves back along the z-axis by the given distance."""
    return SE3(0, 0, -distance)

def facing(x, y, target):
    # gives a pose on the floor at (x, y) facing the target point (target_x, target_y)
    angle = np.arctan2(target[1] - y, target[0] - x)
    return SE3(x, y, 0) * SE3.Rz(angle)

